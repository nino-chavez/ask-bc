# =============================================================================
# BigCommerce App Credentials
# Get these from: https://devtools.bigcommerce.com/my/apps
# =============================================================================
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=

# The public URL of this app (no trailing slash)
# Local dev: use ngrok (e.g. https://abc123.ngrok-free.dev)
# Production: your Vercel deployment URL (e.g. https://ask-bc.vercel.app)
APP_ORIGIN=http://localhost:3000

# Secret for signing internal session JWTs (min 32 chars)
# Generate with: openssl rand -hex 32
JWT_KEY=

# REQUIRED. AES-256-GCM key for encrypting BC access tokens at rest in Redis.
# 32 bytes, hex-encoded (64 chars). Plaintext token storage is NOT permitted —
# missing key will fail startup. Must match the Worker's CREDENTIAL_ENCRYPTION_KEY.
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=

# =============================================================================
# AI / LLM
# =============================================================================
ANTHROPIC_API_KEY=

# =============================================================================
# Upstash Redis (REQUIRED for production)
# Store OAuth tokens. Without Redis, tokens are lost on restart.
# On Vercel: add the Vercel Marketplace Upstash integration. The integration
# now provisions these to Production+Preview only (Sensitive) — set your
# own dev values below so local runs don't touch prod.
# =============================================================================
KV_REST_API_URL=
KV_REST_API_TOKEN=

# =============================================================================
# BigCommerce API URLs (defaults — rarely need to change)
# =============================================================================
# BIGCOMMERCE_API_URL=https://api.bigcommerce.com
# BIGCOMMERCE_LOGIN_URL=https://login.bigcommerce.com
