{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ask-bc-agent-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        // Binding name MUST match class name exactly so
        // camelCaseToKebabCase(bindingName) produces the same result as
        // camelCaseToKebabCase(className) — this is how the client's
        // useAgent({agent: "AskBC"}) namespace resolves to the DO.
        "name": "AskBC",
        "class_name": "AskBC"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AskBC"]
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "BC_API_BASE": "https://api.bigcommerce.com",
    "APP_ORIGIN": "https://askbc.ninochavez.co"
  }
  // Secrets set via wrangler secret put:
  //   ANTHROPIC_API_KEY         — Anthropic API key (Haiku + Sonnet)
  //   UPSTASH_REDIS_REST_URL    — Per-store credential lookup
  //   UPSTASH_REDIS_REST_TOKEN  — Upstash auth
  //   CREDENTIAL_ENCRYPTION_KEY — AES-256-GCM key for encrypted tokens [S-7]
  //   JWT_KEY                   — Same secret as Vercel; verifies agent tokens [S-1]
  //
  // Dev-only fallback (ALL THREE required together):
  //   DEV_MODE=true             — Explicit opt-in for env-var credentials
  //   BC_STORE_HASH             — Single store hash
  //   BC_ACCESS_TOKEN           — Single store access token
  //   + APP_ORIGIN must include localhost or 127.0.0.1
}
