{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ask-bc-agent-runtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-03-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        // Binding name MUST match class name exactly so
        // camelCaseToKebabCase(bindingName) produces the same result as
        // camelCaseToKebabCase(className) — this is how the client's
        // useAgent({agent: "AskBC"}) namespace resolves to the DO.
        "name": "AskBC",
        "class_name": "AskBC"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["AskBC"]
    }
  ],
  "worker_loaders": [
    {
      "binding": "LOADER"
    }
  ],
  "vars": {
    "BC_API_BASE": "https://api.bigcommerce.com",
    "APP_ORIGIN": "https://ask-bc-dun.vercel.app"
  }
  // Secrets set via wrangler secret put:
  //   ANTHROPIC_API_KEY         — Anthropic API key (Haiku + Sonnet)
  //   BC_STORE_HASH             — Dev fallback: single store hash
  //   BC_ACCESS_TOKEN           — Dev fallback: single store token
  //   UPSTASH_REDIS_REST_URL    — Production: per-store credential lookup
  //   UPSTASH_REDIS_REST_TOKEN  — Production: Upstash auth
  //   CREDENTIAL_ENCRYPTION_KEY — Optional: AES-256-GCM key for encrypted tokens [S-7]
}
